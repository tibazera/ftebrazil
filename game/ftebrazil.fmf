game quake
name "FTE Brazil"
basegame id1
basegame *fte

bind w +forward
bind s +back
bind a +moveleft
bind d +moveright
bind mouse1 +attack
bind mouse2 +jump
bind tab +showscores
bind t messagemode
bind y messagemode2

// Adicione aqui o pacote permitido e o servidor quando estiverem definidos.
// package id1/pak0.pak - "https://SEU-CDN/pak0.pak"
// connect "wss://SEU-SERVIDOR"
